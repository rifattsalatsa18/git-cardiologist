# Copy this file to .env.local and fill in your own Supabase project credentials.
# Find these in your Supabase project: Settings -> API.
# VITE_-prefixed variables are exposed to the browser bundle by Vite — never put
# a service_role / secret key in a VITE_ variable, only the public anon key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
